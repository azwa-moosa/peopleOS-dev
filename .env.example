# ---- Environment safety -------------------------------------------------
# dev | uat | prod. Mock IdP is refused at boot unless PLATFORM_ENV=dev.
PLATFORM_ENV=dev
MOCK_IDP_ENABLED=true

# ---- Database ------------------------------------------------------------
# Migrator (DDL, owner). Used only by migrate/seed and the worker's audit relay.
DATABASE_URL_MIGRATOR=postgres://app_migrator:app_migrator_dev@localhost:5432/bml_people_er
# Runtime (DML only, subject to RLS, cannot UPDATE/DELETE audit).
# Optional: if unset, derived from DATABASE_URL_MIGRATOR with user app_runtime + APP_RUNTIME_PASSWORD.
DATABASE_URL=postgres://app_runtime:app_runtime_dev@localhost:5432/bml_people_er
APP_RUNTIME_PASSWORD=app_runtime_dev

# ---- Auth ------------------------------------------------------------------
# DEV mock IdP signing secret (never used outside dev).
DEV_JWT_SECRET=change-me-dev-only-secret-at-least-32-chars
# Microsoft Entra ID (optional in DEV). When set, Entra access tokens are accepted.
ENTRA_TENANT_ID=
ENTRA_API_AUDIENCE=

# ---- Crypto ----------------------------------------------------------------
# 32-byte base64 key for field-level encryption of ER narrative fields (DEV key only).
FIELD_ENCRYPTION_KEY=fSrEhJvVcTGnzPZAoU/0RdNdXeEwnnLnjxvEqtg+/eg=

# ---- Ports -----------------------------------------------------------------
API_PORT=4000
WEB_PORT=3000
API_BASE_URL=http://localhost:4000
# Run the outbox → audit relay inside the API (hosts without a background worker, e.g. Render free).
EMBEDDED_OUTBOX_RELAY=false
